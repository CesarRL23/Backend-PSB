{
  "info": {
    "name": "iPSB — Yahir (Limpieza + Users + Notifications)",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Endpoints del módulo Limpieza y Desinfección, Users y Notifications.\nVariable {{baseUrl}} = http://localhost:3000\nVariable {{token}} = JWT de Supabase Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token",   "value": "",                     "type": "string", "description": "JWT de Supabase Auth" }
  ],
  "item": [

    {
      "name": "Users",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"uuid-de-supabase-auth\",\n  \"empresaId\": \"00000000-0000-0000-0000-000000000001\",\n  \"nombre\": \"Carlos López\",\n  \"email\": \"carlos@empresa.com\",\n  \"rol\": \"operario\",\n  \"estado\": \"activo\",\n  \"cargo\": \"Auxiliar de limpieza\"\n}"
            }
          }
        },
        {
          "name": "Listar usuarios",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" }
        },
        {
          "name": "Buscar usuario por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/{{usuarioId}}" }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{usuarioId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cargo\": \"Jefe de limpieza\",\n  \"estado\": \"activo\"\n}"
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{usuarioId}}" }
        }
      ]
    },

    {
      "name": "Notifications",
      "item": [
        {
          "name": "Crear notificación",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notifications",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"00000000-0000-0000-0000-000000000002\",\n  \"programaId\": \"00000000-0000-0000-0000-000000000003\",\n  \"tipo\": \"alerta\",\n  \"titulo\": \"Verificación pendiente\",\n  \"mensaje\": \"El programa de limpieza requiere verificación.\",\n  \"fechaEnvio\": \"2026-05-14T10:00:00Z\",\n  \"fechaLimite\": \"2026-05-15T18:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Listar notificaciones",
          "request": { "method": "GET", "url": "{{baseUrl}}/notifications" }
        },
        {
          "name": "Notificaciones por usuario",
          "request": { "method": "GET", "url": "{{baseUrl}}/notifications/usuario/{{usuarioId}}" }
        },
        {
          "name": "Buscar notificación por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/notifications/{{notificacionId}}" }
        },
        {
          "name": "Actualizar notificación",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/{{notificacionId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"enviada\"\n}"
            }
          }
        },
        {
          "name": "Marcar como leída",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/notifications/{{notificacionId}}/leer" }
        },
        {
          "name": "Eliminar notificación",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/notifications/{{notificacionId}}" }
        }
      ]
    },

    {
      "name": "Programa Limpieza",
      "item": [
        {
          "name": "Crear programa limpieza",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/programas-limpieza",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programaId\": \"00000000-0000-0000-0000-000000000010\",\n  \"objetivo\": \"Eliminar residuos orgánicos e inorgánicos de superficies de contacto con alimentos\",\n  \"alcance\": \"Todas las áreas de producción y almacenamiento\",\n  \"procedimientoGeneral\": \"Barrer, lavar con detergente, enjuagar, aplicar desinfectante y dejar secar.\"\n}"
            }
          }
        },
        {
          "name": "Listar programas limpieza",
          "request": { "method": "GET", "url": "{{baseUrl}}/programas-limpieza" }
        },
        {
          "name": "Por programa",
          "request": { "method": "GET", "url": "{{baseUrl}}/programas-limpieza/por-programa/{{programaId}}" }
        },
        {
          "name": "Buscar por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/programas-limpieza/{{programaLimpiezaId}}" }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/programas-limpieza/{{programaLimpiezaId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objetivo\": \"Objetivo actualizado\"\n}"
            }
          }
        },
        {
          "name": "Eliminar",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/programas-limpieza/{{programaLimpiezaId}}" }
        }
      ]
    },

    {
      "name": "Paso Limpieza",
      "item": [
        {
          "name": "Crear paso",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pasos-limpieza",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programaLimpiezaId\": \"{{programaLimpiezaId}}\",\n  \"orden\": 1,\n  \"descripcion\": \"Retirar residuos sólidos visibles con escoba o cepillo\",\n  \"tipoAccion\": \"barrido_en_seco\",\n  \"frecuencia\": \"diario\",\n  \"concentracion\": \"N/A\",\n  \"tiempoContacto\": \"5 min\",\n  \"temperaturaAguaMinima\": 40,\n  \"temperaturaAguaMaxima\": 60\n}"
            }
          }
        },
        {
          "name": "Listar pasos",
          "request": { "method": "GET", "url": "{{baseUrl}}/pasos-limpieza" }
        },
        {
          "name": "Por programa limpieza",
          "request": { "method": "GET", "url": "{{baseUrl}}/pasos-limpieza/por-programa-limpieza/{{programaLimpiezaId}}" }
        },
        {
          "name": "Buscar por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/pasos-limpieza/{{pasoLimpiezaId}}" }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/pasos-limpieza/{{pasoLimpiezaId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperaturaAguaMinima\": 45,\n  \"temperaturaAguaMaxima\": 65\n}"
            }
          }
        },
        {
          "name": "Eliminar",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/pasos-limpieza/{{pasoLimpiezaId}}" }
        }
      ]
    },

    {
      "name": "Paso Limpieza PQ",
      "item": [
        {
          "name": "Asignar producto a paso",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pasos-limpieza-pq",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pasoLimpiezaId\": \"{{pasoLimpiezaId}}\",\n  \"productoQuimicoId\": \"{{productoQuimicoId}}\",\n  \"concentracionValor\": 200,\n  \"concentracionUnidad\": \"ppm\",\n  \"tiempoContactoMin\": 10\n}"
            }
          }
        },
        {
          "name": "Productos de un paso",
          "request": { "method": "GET", "url": "{{baseUrl}}/pasos-limpieza-pq/por-paso/{{pasoLimpiezaId}}" }
        },
        {
          "name": "Buscar por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/pasos-limpieza-pq/{{pasoLimpiezaPqId}}" }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/pasos-limpieza-pq/{{pasoLimpiezaPqId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"concentracionValor\": 250,\n  \"concentracionUnidad\": \"ppm\",\n  \"tiempoContactoMin\": 15\n}"
            }
          }
        },
        {
          "name": "Desasignar",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/pasos-limpieza-pq/{{pasoLimpiezaPqId}}" }
        }
      ]
    },

    {
      "name": "Producto Quimico",
