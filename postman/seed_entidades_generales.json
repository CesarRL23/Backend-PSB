      "id": { "tipo": "UUID", "pk": true },
      "empresa_id": { "tipo": "UUID", "fk": "EMPRESA.id", "requerido": true },
      "tipo_alimento_id": { "tipo": "UUID", "fk": "TIPO_ALIMENTO.id", "requerido": true },
      "version": { "tipo": "STRING", "requerido": true },
      "estado": {
        "tipo": "ENUM",
        "valores": ["BORRADOR", "ACTIVO", "OBSOLETO"],
        "requerido": true
      },
      "nivel_riesgo": {
        "tipo": "ENUM",
        "valores": ["ALTO", "MEDIO", "BAJO"],
        "requerido": true
      },
      "fecha_creacion": { "tipo": "DATE", "requerido": true },
      "fecha_actualizacion": { "tipo": "DATE", "nullable": true }
    },
