      "mensaje": { "tipo": "TEXT", "requerido": true },
      "fecha_envio": { "tipo": "DATETIME", "requerido": true },
      "fecha_limite": { "tipo": "DATETIME", "nullable": true },
      "leida": { "tipo": "BOOLEAN", "requerido": true, "default": false },
      "estado": { "tipo": "STRING", "requerido": true, "nota": "Ej: PENDIENTE, GESTIONADA, VENCIDA" }
    },
