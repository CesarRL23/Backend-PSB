      "programa_id": { "tipo": "UUID", "fk": "PROGRAMA.id", "requerido": true },
      "usuario_id": { "tipo": "UUID", "fk": "USUARIO.id", "requerido": true },
      "fecha": { "tipo": "DATE", "requerido": true },
      "hora_inicio": { "tipo": "TIME", "nullable": true },
      "hora_fin": { "tipo": "TIME", "nullable": true },
      "observaciones": { "tipo": "TEXT", "nullable": true },
      "evidencia_foto": { "tipo": "STRING", "nullable": true, "nota": "URL de imagen de evidencia" }
    },
    "ejemplo": {
      "id": "a1b2c3d4-0008-0001-0001-000000000001",
